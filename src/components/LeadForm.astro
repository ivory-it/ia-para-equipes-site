---
/**
 * Formulário de lead da seção de contato da home. (O Radar pede os dados
 * dentro do chat.) O comportamento e o envio ficam em `src/scripts/lead-form.ts`,
 * e quem usa o componente chama `initLeadForm` no próprio script.
 *
 * `id` prefixa os ids internos, para caber mais de uma instância no site.
 * `showFormat={false}` tira o "Formato de interesse".
 */
import { Icon } from 'astro-icon/components';

interface Props {
  id: string;
  showFormat?: boolean;
  submitLabel?: string;
  successTitle?: string;
  successText?: string;
}

const {
  id,
  showFormat = true,
  submitLabel = 'Quero avaliar para minha equipe',
  successTitle = 'Recebemos seu contato.',
  successText = 'Retornamos em breve pelo e-mail informado.',
} = Astro.props;

// Faixas alinhadas à turma de 50 participantes da oferta padrão.
const teamSizes = ['Até 50', '51 a 100', '101 a 250', 'Mais de 250'];

// `value` casa com o `data-contact-plan` dos botões da seção de investimento.
const formats = [
  { value: 'padrao', label: 'Turma padrão' },
  { value: 'personalizado', label: 'Personalizada' },
];

// Enviadas num texto só, separado por vírgula (ver lead-form.ts).
const tools = ['Claude', 'ChatGPT', 'Gemini', 'Microsoft 365 Copilot', 'Outra'];

const field =
  'mt-2 w-full rounded-2xl border border-ink/[0.14] bg-paper px-4 py-3 text-[15px] text-ink placeholder:text-ink-soft transition focus:border-accent-ink focus:outline-none focus:ring-2 focus:ring-accent/25';
const label = 'text-sm font-medium text-ink';
const pill =
  'flex cursor-pointer items-center gap-3 rounded-2xl border border-ink/[0.14] bg-paper px-4 py-3 text-[15px] text-ink-2 transition hover:border-ink/[0.28] has-checked:border-accent-ink has-checked:bg-accent/[0.08] has-checked:text-ink has-focus-visible:ring-2 has-focus-visible:ring-accent/40';
---

<div data-lead-root={id}>
<form id={`${id}-form`} data-lead-form class="grid gap-5 sm:grid-cols-2" novalidate>
<div class="sm:col-span-2">
<label class={label} for={`${id}-nome`}>Nome</label>
<input class={field} id={`${id}-nome`} name="nome" type="text" autocomplete="name" required />
</div>
<div class="sm:col-span-2">
<label class={label} for={`${id}-email`}>E-mail corporativo</label>
<input class={field} id={`${id}-email`} name="email" type="email" autocomplete="email" placeholder="voce@empresa.com.br" required />
</div>
<div>
<label class={label} for={`${id}-cargo`}>Cargo</label>
<input class={field} id={`${id}-cargo`} name="cargo" type="text" autocomplete="organization-title" required />
</div>
<div>
<label class={label} for={`${id}-whatsapp`}>WhatsApp</label>
<input class={field} id={`${id}-whatsapp`} name="whatsapp" type="tel" autocomplete="tel" inputmode="tel" placeholder="(00) 00000-0000" maxlength="15" required />
</div>
<div class="sm:col-span-2">
<label class={label} for={`${id}-colaboradores`}>Colaboradores a capacitar</label>
<div class="relative">
<select class:list={[field, 'appearance-none pr-10']} id={`${id}-colaboradores`} name="colaboradores" required>
<option value="" disabled selected>Selecione</option>
{teamSizes.map((size) => <option value={size}>{size}</option>)}
</select>
<svg class="pointer-events-none absolute top-1/2 right-4 mt-1 h-4 w-4 -translate-y-1/2 text-ink-soft" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
</div>
</div>
<fieldset class="sm:col-span-2">
<legend class={label}>Ferramentas de IA que a equipe usa</legend>
{/* Pílulas em fluxo, com a largura do texto: na grade de duas colunas,
    "Microsoft 365 Copilot" quebrava em três linhas em 390 px. */}
<div class="mt-2 flex flex-wrap gap-3">
{tools.map((tool) => (
<label class:list={[pill, 'whitespace-nowrap']}>
<input class="h-4 w-4 shrink-0 accent-accent-ink" type="checkbox" name="ferramentas" value={tool} />
{tool}
</label>
))}
</div>
<div data-other-wrap class="mt-3" hidden>
<label class="sr-only" for={`${id}-outra`}>Qual outra ferramenta?</label>
<input class={field} id={`${id}-outra`} name="ferramenta_outra" type="text" placeholder="Qual outra ferramenta?" />
</div>
</fieldset>
{showFormat && (
<fieldset class="sm:col-span-2">
<legend class={label}>Formato de interesse</legend>
<div class="mt-2 grid gap-3 sm:grid-cols-2">
{formats.map(({ value, label: text }, i) => (
<label class={pill}>
<input class="h-4 w-4 shrink-0 accent-accent-ink" type="radio" name="formato" value={value} data-label={text} required={i === 0} />
{text}
</label>
))}
</div>
</fieldset>
)}
<slot name="before-submit" />
<p data-lead-error class="sm:col-span-2 flex items-start gap-2 rounded-2xl border border-ink/[0.14] bg-ink/[0.04] px-4 py-3 text-sm text-ink" role="alert" hidden>
<Icon name="solar:danger-circle-linear" width={18} height={18} class="mt-px shrink-0" aria-hidden="true" />
<span data-message></span>
</p>
<button type="submit" class="group sm:col-span-2 mt-1 inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full bg-accent-ink px-4 py-3.5 text-[13px] sm:px-6 sm:text-sm font-semibold text-paper shadow-2xl shadow-ink/20 transition duration-300 ease-out hover:bg-accent-ink-strong disabled:cursor-wait disabled:opacity-70">
<span data-label>{submitLabel}</span>
<Icon name="solar:arrow-right-linear" width={18} height={18} class="hidden sm:block transition duration-300 ease-out group-hover:translate-x-0.5" />
</button>
<slot name="after-submit" />
</form>

<div data-lead-success class="hidden flex-col items-center py-10 text-center" role="status" tabindex="-1">
<span class="flex h-14 w-14 items-center justify-center rounded-2xl border border-accent-ink/20 bg-accent/[0.1] text-accent-ink" aria-hidden="true">
<Icon name="solar:check-circle-linear" width={28} height={28} />
</span>
<p class="mt-6 font-display text-2xl font-medium tracking-tight text-ink">{successTitle}</p>
<p class="mt-2 text-[15px] leading-relaxed text-ink-soft">{successText}</p>
</div>
</div>
