---
/**
 * Print de tela com moldura de janela e lightbox.
 *
 * A miniatura sai em WebP em três larguras, e o celular baixa a de 480 ou 960.
 * A versão grande (até 1920w) só é baixada quando o visitante toca no print.
 * Os prints não recebem filtro: o que aparece é a tela como ela é.
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { Icon } from 'astro-icon/components';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
}

const { src, alt, sizes = '(min-width: 1024px) 640px, calc(100vw - 4rem)' } = Astro.props;
const full = await getImage({ src, width: Math.min(1920, src.width), format: 'webp', quality: 85 });
---

<figure class="m-0">
  <button
    type="button"
    data-lightbox
    data-full={full.src}
    data-alt={alt}
    data-width={full.attributes.width ?? src.width}
    data-height={full.attributes.height ?? src.height}
    aria-label={`Ampliar: ${alt}`}
    class="group relative block w-full cursor-zoom-in overflow-hidden rounded-xl border border-ink/[0.14] bg-paper text-left shadow-xl shadow-ink/[0.08] transition duration-300 hover:border-ink/[0.28] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50"
  >
    <Image
      src={src}
      alt={alt}
      widths={[480, 960, 1600].filter((w) => w <= src.width)}
      sizes={sizes}
      format="webp"
      loading="lazy"
      class="block h-auto w-full"
    />
    <span
      aria-hidden="true"
      class="absolute right-2 bottom-2 inline-flex items-center gap-1.5 rounded-full border border-ink/[0.12] bg-paper/[0.92] px-2.5 py-1 text-xs font-medium text-ink-2 shadow-lg shadow-ink/[0.08] backdrop-blur-xl transition group-hover:text-ink"
    >
      <Icon name="solar:magnifier-zoom-in-linear" width={14} height={14} />
      Toque para ampliar
    </span>
  </button>
</figure>
