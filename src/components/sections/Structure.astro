];

// A jornada: o diagnóstico prepara, as duas sessões são o encontro ao vivo.
const steps = [
  { label: 'Etapa 01', when: 'Após a contratação', title: 'Diagnóstico de maturidade', detail: 'Os participantes respondem a uma pesquisa antes das sessões.', prep: true },
  { label: 'Etapa 02', when: '2 horas', title: 'Sessão 1 · Fundamentos', detail: 'Como a IA funciona, onde ela agrega valor e como usá-la com segurança, geração de bons contextos/prompts e validação das respostas.', prep: false },
  { label: 'Etapa 03', when: '2 horas', title: 'Sessão 2 · Aplicação', detail: 'Demonstração de um fluxo de trabalho simulado explorando funcionalidades básicas/avançadas das ferramentas.', prep: false },
];
---

<section class="relative overflow-hidden border-t border-ink/[0.09] px-5 pt-24 pb-24 sm:px-8 lg:px-10" id="como-funciona">
<div class="mx-auto w-full max-w-[1280px]">

{/* Cabeçalho no padrão das demais seções: título à esquerda, explicação e CTA à direita. */}
<div class="reveal grid gap-8 lg:grid-cols-[1fr_0.72fr] lg:items-end">
<div class="max-w-4xl">
<p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent-ink">Como funciona</p>
<h2 class="mt-5 text-4xl text-ink sm:text-5xl lg:text-6xl tracking-tighter leading-tight font-display font-medium">Como a capacitação se estrutura</h2>
</div>
<div class="lg:ml-auto lg:max-w-md">
<p class="text-lg leading-8 text-ink-soft">Um formato corporativo, enxuto e aplicável, desenhado para criar base comum e orientar o uso das ferramentas oficiais da empresa.</p>
<div class="mt-7 flex">
<a class="group inline-flex whitespace-nowrap items-center justify-center gap-2 shadow-ink/30 transition duration-300 ease-out hover:scale-[1.03] hover:bg-accent-ink-strong hover:shadow-accent-ink/10 text-sm font-semibold text-paper bg-accent-ink rounded-full pt-3 pr-5 pb-3 pl-5 shadow-2xl" href="#contato">
Quero capacitar minha equipe
<Icon name="solar:arrow-right-linear" width={18} height={18} class="transition duration-300 ease-out group-hover:translate-x-0.5" />
</a>
</div>
</div>
</div>

{/* Quatro cards de formato. A casca de vidro vem dos cards do HowItWorks. */}
<ul class="reveal mt-12 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
{facts.map(({ icon, title, lead, detail }) => (
<li data-reveal-skip class="group relative overflow-hidden rounded-3xl border border-ink-2/20 bg-paper/[0.60] p-6 text-center shadow-[0_0_0_1px_rgba(10,37,64,0.08),0_18px_55px_rgba(10,37,64,0.08),inset_0_1px_0_rgba(255,255,255,0.70)] transition duration-300 hover:-translate-y-1 hover:border-ink-2/40 hover:bg-paper/[0.82]">
<div class="pointer-events-none absolute inset-x-5 top-0 h-px bg-linear-to-r from-transparent via-ink-2/60 to-transparent"></div>
<div class="relative z-10 flex h-full flex-col items-center">
<span class="flex h-12 w-12 items-center justify-center rounded-2xl border border-accent-ink/20 bg-accent/[0.1] text-accent-ink" aria-hidden="true">
<Icon name={icon} width={24} height={24} />
</span>
<h3 class="mt-5 font-display text-xl font-medium tracking-tight text-ink">{title}</h3>
<p class="mt-3 text-[0.95rem] leading-6 text-ink-2 md:min-h-12 [&_strong]:font-semibold [&_strong]:text-ink" set:html={lead} />
<span class="my-5 h-0.5 w-8 rounded-full bg-accent" aria-hidden="true"></span>
{detail ? (
<p class="text-sm leading-6 text-ink-soft">{detail}</p>
) : (
<div class="flex flex-col items-center">
<div class="flex items-center gap-5 text-ink-soft">
{tools.map(({ name, viewBox, d }) => (
<svg class="h-7 w-7" viewBox={viewBox} fill="currentColor" role="img" aria-label={name}><title>{name}</title><path d={d} /></svg>
))}
</div>
<p class="mt-4 text-sm leading-6 text-ink-soft">ou outras soluções homologadas.</p>
</div>
)}
</div>
</li>
))}
</ul>

{/* Jornada em três etapas. Quem guia a leitura é a pílula "Etapa 0X", sem
    ícone nem numeral competindo com ela. O diagnóstico é translúcido e
    tracejado (preparação); as sessões são sólidas, com sombra (encontro ao
    vivo). O tracejado entre os cards é decorativo e estático. As três colunas
    só começam em xl: em 1024 px o texto das sessões quebrava em 4 a 5 linhas. */}
<ol class="reveal mt-6 grid gap-4 xl:grid-cols-3 xl:gap-6">
{steps.map(({ label, when, title, detail, prep }, i) => (
<li data-reveal-skip class:list={[
  'relative rounded-3xl p-5 sm:p-6',
  prep
    ? 'border border-dashed border-ink/[0.18] bg-paper/[0.45] backdrop-blur-xl'
    : 'border border-accent-ink/20 bg-paper shadow-xl shadow-ink/[0.08]',
]}>
{i > 0 && (
<>
<span class="absolute -top-4 left-1/2 h-4 -translate-x-1/2 border-l-2 border-dashed border-accent/50 xl:hidden" aria-hidden="true"></span>
<span class="absolute top-1/2 -left-6 hidden w-6 border-t-2 border-dashed border-accent/50 xl:block" aria-hidden="true"></span>
</>
)}
<div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
<p class="inline-flex w-fit rounded-full border border-ink-soft/20 bg-ink/10 px-3 py-1 text-[0.68rem] font-medium uppercase tracking-[0.16em] text-ink">{label}</p>
<p class="text-xs text-ink-soft">{when}</p>
</div>
<h3 class="mt-4 text-base font-semibold text-ink">{title}</h3>
<p class="mt-1.5 text-sm leading-6 text-ink-soft">{detail}</p>
</li>
))}
</ol>

</div>
</section>
