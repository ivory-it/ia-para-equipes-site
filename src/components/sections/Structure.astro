---
import { Icon } from 'astro-icon/components';

// Os quatro cards de formato. `lead` aceita <strong> para os destaques.
const facts = [
  { icon: 'solar:calendar-linear', title: 'Formato', lead: '<strong>2 encontros</strong> ao vivo<br />de <strong>2 horas</strong> cada', detail: 'Formato enxuto e de baixa fricção para a agenda das equipes.' },
  { icon: 'solar:users-group-rounded-linear', title: 'Turma', lead: '<strong>Até 50 participantes</strong><br />por turma', detail: 'Ideal para formar uma referência comum entre áreas e equipes.' },
  { icon: 'solar:laptop-linear', title: 'Modalidade', lead: '<strong>Online</strong> (via Teams)', detail: 'Facilita a adesão, elimina deslocamentos e permite participação de diferentes unidades e localidades.' },
  { icon: 'solar:settings-minimalistic-linear', title: 'Ferramentas', lead: 'Nas ferramentas <strong>oficiais</strong><br />da empresa', detail: null },
];

// Logos monocromáticos, em currentColor. Origem dos paths: OpenAI e Claude do
