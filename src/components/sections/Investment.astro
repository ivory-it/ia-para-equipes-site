---
import { Icon } from 'astro-icon/components';

// Dois formatos, sem alternador mensal/anual: a capacitação é cobrada por turma.
// `featured` liga a casca destacada (a do card "Pro" do template). `plan` casa com
// o rádio "formato" do Contact.astro: o botão já chega com o formato marcado.
const plans = [
  {
    label: 'Turma padrão',
    title: 'Capacitação IA para Equipes',
    badge: 'Padrão',
    plan: 'padrao',
    price: 'R$ 12.000',
    period: 'por turma',
    detail: 'O formato completo para criar uma base comum de uso de IA com segurança.',
    cta: 'Quero capacitar minha equipe',
    items: [
      'Até 50 participantes',
      '2 sessões online ao vivo, de 2 horas (via Teams)',
      'Diagnóstico de maturidade: pesquisa antes das sessões e entrega do resultado',
      'Gravação das duas sessões',
      'Nas ferramentas oficiais da empresa',
    ],
    featured: true,
  },
  {
    label: 'Personalizada',
    title: 'Capacitação personalizada',
    badge: 'Customizável',
    plan: 'personalizado',
    price: 'Sob consulta',
    period: null,
    detail: 'Adaptamos conteúdo, exemplos e atividades às jornadas, ferramentas e desafios reais das suas áreas.',
    cta: 'Fale conosco',
    items: [
      'Tudo da turma padrão',
      'Práticas em jornadas reais da empresa',
      'Exemplos e casos das áreas participantes',
      'Carga horária e número de turmas ajustados à necessidade',
    ],
    featured: false,
  },
];
---

<section class="relative overflow-hidden border-t border-ink/[0.09] px-5 pt-24 pb-24 sm:px-8 lg:px-10" id="investimento">
<div class="pointer-events-none absolute left-1/2 top-0 h-[34rem] w-[34rem] -translate-x-1/2 rounded-full bg-ink/10 blur-3xl"></div>
<div class="pointer-events-none absolute inset-0 opacity-[0.035]" style="background-image: linear-gradient(to right, rgba(10,37,64,0.85) 1px, transparent 1px), linear-gradient(to bottom, rgba(10,37,64,0.65) 1px, transparent 1px); background-size: 28rem 28rem;"></div>
<div class="relative z-10 mx-auto w-full max-w-[1280px]">

{/* Cabeçalho sem CTA: os botões estão nos cards. */}
<div class="reveal grid gap-8 lg:grid-cols-[1fr_0.72fr] lg:items-end">
<div class="max-w-4xl">
<p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent-ink">Investimento</p>
<h2 class="mt-5 text-4xl text-ink sm:text-5xl lg:text-6xl tracking-tighter leading-tight font-display font-medium">Capacite sua equipe com investimento previsível</h2>
</div>
<div class="lg:ml-auto lg:max-w-md">
<p class="text-lg leading-8 text-ink-soft">Comece com o formato padrão ou leve a capacitação para dentro das jornadas reais da sua empresa.</p>
</div>
</div>

{/* Cascas dos cards "Pro" (destacado) e "Starter" (neutro) do Pricing.astro. Em lg,
    cada card é um subgrid de 5 linhas (cabeçalho, preço, botão, divisor, lista):
    se um título ou parágrafo quebra a mais, a linha cresce nos dois cards e
    preço, botão e lista seguem alinhados. */}
<div class="reveal mx-auto mt-12 grid max-w-5xl gap-6 lg:grid-cols-2">
{plans.map(({ label, title, badge, plan, price, period, detail, cta, items, featured }) => (
<article data-reveal-skip class:list={[
  'group relative flex flex-col lg:row-span-5 lg:grid lg:grid-rows-subgrid lg:gap-y-0 rounded-[2rem] bg-linear-to-b p-6 sm:p-8 transition duration-300 ease-out hover:-translate-y-1',
  featured ? 'from-accent/[0.13] via-paper/[0.55] to-transparent shadow-2xl shadow-ink/[0.09]' : 'from-paper/[0.70] to-transparent',
]}>
<div class:list={[
  'pointer-events-none absolute inset-0 rounded-[2rem] border transition-colors',
  featured ? 'border-accent/40 group-hover:border-accent/60' : 'border-ink/[0.12] group-hover:border-ink/[0.22]',
]}></div>
<div class:list={['absolute inset-x-4 top-0 h-px bg-linear-to-r from-transparent to-transparent', featured ? 'via-accent/60' : 'via-ink-2/40']}></div>
{/* A pílula fica na linha do rótulo, não ao lado do título: ao lado, ela
    tomava ~130 px e "Capacitação personalizada" quebrava em duas linhas. */}
<div>
<div class="flex items-center justify-between gap-6">
<p class:list={['text-[11px] font-semibold uppercase tracking-widest', featured ? 'text-ink-2' : 'text-ink-soft']}>{label}</p>
<span class:list={[
  'shrink-0 rounded-full border px-3 py-1 text-xs font-medium',
  featured ? 'border-ink-2/20 bg-ink-soft/10 text-ink' : 'border-ink/[0.12] bg-paper/[0.65] text-ink-soft',
]}>{badge}</span>
</div>
<h3 class="mt-3 font-display text-[24px] font-medium tracking-tight text-ink">{title}</h3>
</div>
<div class="mt-8">
<div class="flex flex-wrap items-end gap-x-2">
<span class="font-display text-4xl font-medium tracking-tight text-ink sm:text-5xl">{price}</span>
{period && <span class="pb-2 text-sm text-ink-soft">{period}</span>}
</div>
<p class:list={['mt-4 text-[15px] leading-relaxed', featured ? 'text-ink-2' : 'text-ink-soft']}>{detail}</p>
</div>
<a href="#contato" data-contact-plan={plan} class:list={[
  'group/cta mt-8 inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm transition duration-300 ease-out',
  featured
    ? 'bg-accent-ink font-semibold text-paper shadow-2xl shadow-ink/20 hover:bg-accent-ink-strong'
    : 'border border-ink/[0.12] bg-paper/[0.65] font-medium text-ink hover:border-ink/[0.22] hover:bg-paper/[0.88]',
]}>
{cta}
<Icon name="solar:arrow-right-linear" width={18} height={18} class="transition duration-300 ease-out group-hover/cta:translate-x-0.5" />
</a>
<div class:list={['mt-8 h-px w-full', featured ? 'bg-ink/15' : 'bg-paper/[0.82]']}></div>
<ul class:list={['mt-8 space-y-4 text-[15px] leading-6', featured ? 'text-ink-2' : 'text-ink-soft']}>
{items.map((item) => (
<li data-reveal-skip class="flex gap-3">
<span class:list={['mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full', featured ? 'bg-ink-2/15 text-ink' : 'bg-ink/10 text-ink-2']}>
<svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
</span>
{item}
</li>
))}
</ul>
</article>
))}
</div>

<div class="reveal mx-auto mt-10 max-w-5xl rounded-[2rem] border border-ink/[0.12] p-6 text-center">
<p class="text-[15px] leading-relaxed text-ink-soft">O valor da turma padrão vale para até 50 participantes. Mais turmas ou mais participantes entram na proposta personalizada.</p>
</div>

</div>
</section>
