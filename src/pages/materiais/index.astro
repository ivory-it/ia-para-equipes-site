---
/** Índice dos materiais gratuitos. Os cards saem de src/data/materiais/index.ts. */
import Base from '../../layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import { MATERIAIS } from '../../data/materiais';

const title = 'Materiais gratuitos | IA para Equipes';
const description =
  'Prompts prontos e tutoriais passo a passo para usar IA no trabalho do dia a dia, com as ferramentas que a sua empresa já tem.';
---

<Base {title} {description} image={{ src: MATERIAIS[0]!.cover, alt: MATERIAIS[0]!.coverAlt }}>
  <section class="relative overflow-hidden px-5 pt-14 pb-20 sm:px-8 sm:pt-20 lg:px-10 lg:pt-24 lg:pb-24">
    <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true"
      style="background: linear-gradient(225deg, rgb(255 255 255 / 0.55) 0%, rgb(255 255 255 / 0) 48%), radial-gradient(ellipse 60% 50% at 78% 12%, rgb(0 168 142 / 0.07), transparent 70%);"></div>
    <div class="relative z-10 mx-auto w-full max-w-[1280px]">
      <div class="reveal max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent-ink">Materiais</p>
        <h1 data-reveal-skip class="mt-5 font-display text-4xl font-medium tracking-tighter text-ink sm:text-5xl lg:text-6xl lg:leading-[1.05]">Materiais gratuitos</h1>
        <p data-reveal-skip class="mt-6 max-w-2xl text-base leading-7 text-ink-soft sm:text-lg">Prompts prontos e tutoriais passo a passo para usar IA no trabalho do dia a dia, com as ferramentas que a sua empresa já tem.</p>
      </div>

      <ul class="mt-12 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {MATERIAIS.map((m) => (
          <li class="reveal">
            <a
              href={`/materiais/${m.slug}`}
              class="group relative flex h-full flex-col overflow-hidden rounded-3xl border border-ink-2/20 bg-paper/[0.60] shadow-[0_0_0_1px_rgba(10,37,64,0.08),0_18px_55px_rgba(10,37,64,0.08),inset_0_1px_0_rgba(255,255,255,0.70)] transition duration-300 hover:-translate-y-1 hover:border-ink-2/40 hover:bg-paper/[0.82] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50"
            >
              <img src={m.cover} alt={m.coverAlt} width="1200" height="630" loading="lazy" decoding="async" class="block aspect-[1200/630] h-auto w-full border-b border-ink/[0.09] object-cover" />
              <div data-reveal-skip class="flex flex-1 flex-col p-6">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                  <span class="inline-flex rounded-full border border-ink-soft/20 bg-ink/10 px-3 py-1 text-[0.68rem] font-medium uppercase tracking-[0.16em] text-ink">{m.tag}</span>
                  <span class="text-xs text-ink-soft">{m.format}</span>
                </div>
                <h2 class="mt-4 font-display text-xl font-medium tracking-tight text-ink">{m.title}</h2>
                <p class="mt-2 text-[15px] leading-6 text-ink-soft">{m.description}</p>
                <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-accent-ink">
                  Acessar material
                  <Icon name="solar:arrow-right-linear" width={18} height={18} class="transition duration-300 ease-out group-hover:translate-x-0.5" />
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
